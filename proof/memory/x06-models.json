    "ortExecutionRoute": "enforcer-isolated-ort-worker",
    "ortOwnership": "enforcer-isolated-worker",
    "port": 8766,
    "routes": [
      "health",
      "models",
      "load-model",
      "unload-model",
      "chat",
      "embeddings",
      "rerank"
    ]
  },
  "runtimeBackendContract": {
    "llamaCpp": {
      "backend": "gguf",
