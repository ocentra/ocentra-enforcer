  "allowNetwork": false,
  "probeExecutionPolicy": {
    "allowMultiProbe": false,
    "cpuFirst": true,
    "defaultProbeFilter": "chat",
    "gpuAndNpuRequireProviderProbe": true,
    "killOnTimeout": true,
    "minimumChatTokensPerSecond": 10,
    "modelProbeTimeoutMs": 120000,
    "oneModelAtATime": true,
