      "chat-generation-gguf",
      "qwen-embedding-onnx",
      "qwen-reranker-onnx",
      "qwen-embedding-gguf"
    ],
    "providerProbeTimeoutMs": 5000,
    "reason": "one model at a time; CPU first; GPU/NPU only after provider probes pass; timeout kills the child process",
