[
  {
    "name": "subprocess-shell-true: concatenated command",
    "input": "subprocess.run(\"ping -c 1 \" + host, shell=True)",
    "expect": "flag",
    "branch": "subprocess-shell-true",
    "reason": "shell=True is unconditionally flagged"
  },
  {
    "name": "subprocess-shell-true: literal command is still risky",
    "input": "subprocess.call(\"ls -la\", shell=True)",
    "expect": "flag",
    "branch": "subprocess-shell-true",
    "reason": "ANY shell=True is flagged even with a fully static command string"
  },
  {
    "name": "subprocess-shell-true: numeric truthy shell value",
    "input": "subprocess.run(command, shell=1)",
    "expect": "flag",
    "branch": "subprocess-shell-true",
    "reason": "Python treats numeric 1 as truthy, so this enables the shell like shell=True"
  },
  {
    "name": "subprocess-shell-true: clean, no shell keyword",
    "input": "subprocess.run([\"ls\", \"-la\"])",
    "expect": "clean",
    "branch": "subprocess-shell-true",
    "reason": "argv list form, shell keyword absent entirely"
  },
  {
    "name": "subprocess-shell-true: clean, shell explicitly disabled",
    "input": "subprocess.run([\"ls\", \"-la\"], shell=False)",
    "expect": "clean",
    "branch": "subprocess-shell-true",
    "reason": "shell=False is not shell=True"
  },
