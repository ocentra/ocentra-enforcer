    "reason": "Strong with includeSubDomains"
  },
  {
    "name": "hsts_strong_with_preload",
    "input": "{\"headers\": {\"Strict-Transport-Security\": \"max-age=31536000; preload\"}, \"cookies\": []}",
    "expect": "clean",
    "reason": "Strong with preload"
  },
  {
    "name": "hsts_strong_full_config",
    "input": "{\"headers\": {\"Strict-Transport-Security\": \"max-age=31536000; includeSubDomains; preload\"}, \"cookies\": []}",
    "expect": "clean",
    "reason": "Strongest HSTS config"
  },
  {
    "name": "hsts_strong_two_years",
    "input": "{\"headers\": {\"Strict-Transport-Security\": \"max-age=63072000\"}, \"cookies\": []}",
    "expect": "clean",
    "reason": "max-age 2 years >> 1 year"
  },
  {
