  },
  {
    "name": "combined_hsts_strong_csp_unsafe",
    "input": "{\"headers\": {\"Strict-Transport-Security\": \"max-age=31536000; includeSubDomains\", \"Content-Security-Policy\": \"script-src 'unsafe-inline'\"}, \"cookies\": []}",
