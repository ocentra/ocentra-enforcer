{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Enforcer",
  "version": "0.1.0",
  "identifier": "dev.ocentra.enforcer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5174",
    "beforeDevCommand": "npm run dev -- --port 5174",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Enforcer",
        "width": 1500,
        "height": 940,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
