        },
        "docAnchor": "docs/plans/enforcer-selfhost-plan/workpacks/h11-cyberskills-corpus-to-rust-rules.md#Requirement Checklist",
        "tags": ["cyberskills", "h11", "frontmatter", "threat-vocab"]
    },
