            "pass": "crates/enforcer-lang-rust/fixtures/ocentra-parent-posture/pass_no_reexport.rs"
        },
        "docAnchor": "docs/plans/enforcer-selfhost-plan/RUST_ARCHITECTURE.md#borrows-from-ocentraparent",
        "tags": ["rust", "ocentra-parent", "reexports"],
        "params": {
            "publicReexportPolicy": "forbid",
            "pairedValidatorRuleId": "T1-NOREEXPORT.1"
        }
    },
    {
